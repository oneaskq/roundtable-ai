# Reference only. Set variables in the process environment if you need overrides.
# Local startup generates its own signing and encryption keys in data/.
ROUNDTABLE_ENV=development
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
PUBLIC_BASE_URL=http://127.0.0.1:8910

# The interactive configure_model command is preferred for local connections.
# Leave the following unset until you choose a provider and a model.
ROUNDTABLE_AI_PROVIDER=
ROUNDTABLE_AI_MODEL=
ROUNDTABLE_SERVICE_REGION=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=
ROUNDTABLE_QWEN_PLATFORM=

# Mail delivery is optional for local development.
EMAIL_DELIVERY_ENABLED=0
