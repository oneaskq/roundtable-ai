# Copy values into the deployment's private environment settings, never into source control.
# This file does not provision resources, send email, enable model calls, or authorize release.
DJANGO_SETTINGS_MODULE=config.production_settings
ROUNDTABLE_ENV=production
DJANGO_SECRET_KEY=
MFA_ENCRYPTION_KEY=
DJANGO_ALLOWED_HOSTS=
PUBLIC_BASE_URL=

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
PGSSLMODE=verify-full
# Optional path to the database provider's trusted root certificate.
PGSSLROOTCERT=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0

# Leave disabled unless the trusted proxy strips user-supplied forwarding headers.
ROUNDTABLE_TRUST_PROXY_TLS=0
